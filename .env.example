# このファイルをコピーして .env.local にリネームし、値を入力してください（.env* はコミットされません）

# ── クライアント (VITE_ 接頭辞 = ブラウザに公開される値。秘密情報は入れないこと) ──
# Supabase（公開前提の値。保護は supabase/schema.sql の権限と RPC で行う。サーバーも同じ値を使う）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 公開URL（OGP画像・招待リンク用。Vercel では未設定でも本番ドメインが自動で使われる）
VITE_SITE_URL=https://your-app.vercel.app

# ── サーバー専用 (api/ の関数だけが読む。VITE_ を付けないこと) ──
# 駒生成AI: Cloudflare Workers AI（無料プランで1日1万neuron＝約190駒。超えても課金されずエラーになるだけ）
# ダッシュボード > AI > Workers AI > 「REST API を使用」で Account ID と API トークン（Workers AI 読み取り権限）を発行
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
# WORKERS_AI_FALLBACK_MODEL=@cf/zai-org/glm-4.7-flash
# WORKERS_AI_THINKING=true     # モデルに「思考」させる（品質が上がる可能性があるが、1語あたり数十秒かかる）
# 共有キャッシュへの書き込み用トークン（SHA-256 を Supabase の private.config に登録する。未設定でも動作はする）
SUPABASE_SERVER_TOKEN=
# Vercel Cron（/api/backfill）の認証用。Vercel が Authorization ヘッダーに付けて呼ぶ
CRON_SECRET=
# 任意設定
# RATE_LIMIT_PER_HOUR=10            # IPごと・1時間（サーバーのインスタンスごとの目安）
# RATE_LIMIT_PER_DAY=40             # IPごと・1日（Supabase で全サーバー共通に数える）
# RATE_LIMIT_PER_DEVICE_PER_DAY=30  # 端末ごと・1日
# GLOBAL_DAILY_LIMIT=1000
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Gemini API（既定では使わない）──
# Gemini API の利用規約には「18歳未満が利用する可能性が高いサイトでの利用禁止」の条項があるため、
# 誰でも遊べる公開ゲームでは ENABLE_GEMINI を有効にしないこと（自分だけで試す開発用）。
# ENABLE_GEMINI=true
# GEMINI_API_KEY=        # サーバー専用。VITE_ を付けない（付けるとブラウザに配信されて漏れる）
# GEMINI_MODEL=gemini-3.5-flash          # 非推奨で後継に自動で振り替えられる。最新は公式のモデル一覧を確認
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMMA_MODEL=gemma-3-27b-it
# GEMINI_THINKING_BUDGET=0

# ── 予備のLLM（任意）: Gemini が上限・障害のときに使う OpenAI 互換API ──
# 例) Groq:        FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
#     OpenRouter:  FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
#     Cloudflare:  FALLBACK_LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# FALLBACK_LLM_BASE_URL=
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_MODEL=

# ── 公開・安全対策 ──
# 利用規約・プライバシーポリシーの問い合わせ先（Googleフォーム、Xのアカウントなど）と運営者名
VITE_CONTACT_URL=
VITE_OPERATOR_NAME=
# 緊急スイッチ（Vercel で値を変えて再デプロイすると反映）
# FEATURE_AI_GENERATION=off     # AI生成を止める（キャッシュ・近い単語・簡易生成で動き続ける）
# FEATURE_ONLINE_MATCH=off      # オンライン対戦の新規開始を止める
# SITE_NOTICE=ただいま混雑しています  # トップ画面のお知らせ
# NG_WORDS=語1,語2              # 追加のNGワード
