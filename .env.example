# このファイルをコピーして .env.local にリネームし、値を入力してください（.env* はコミットされません）

# ── クライアント (VITE_ 接頭辞 = ブラウザに公開される値。秘密情報は入れないこと) ──
# Firebase の Web 設定（公開前提の識別子。保護は firestore.rules で行う）
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# 公開URL（OGP画像・招待リンク用。Vercel では未設定でも本番ドメインが自動で使われる）
VITE_SITE_URL=https://your-app.vercel.app

# ── サーバー専用 (api/ の関数だけが読む。VITE_ を付けないこと) ──
# Google AI Studio で発行した Gemini APIキー（課金を有効にしていないプロジェクトのキーを推奨）
GEMINI_API_KEY=
# Firebase サービスアカウントJSONを1行にしたもの（共有キャッシュ・レート制限用。未設定でも動作はする）
FIREBASE_SERVICE_ACCOUNT=
# 任意設定
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# GEMINI_THINKING_BUDGET=0   # 0=思考オフ(高速)。品質重視なら 512 など
# RATE_LIMIT_PER_HOUR=10
# GLOBAL_DAILY_LIMIT=200
# ALLOWED_ORIGINS=https://your-app.vercel.app
