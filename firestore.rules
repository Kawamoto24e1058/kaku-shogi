rules_version = '2';

// 架空将棋 Firestore セキュリティルール
// 前提: Firebase Console > Authentication で「匿名」ログインを有効化しておくこと。
// デプロイ: npx firebase-tools deploy --only firestore:rules --project <プロジェクトID>
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // AI生成駒の共有キャッシュ: 誰でも読めるが、書き込みはサーバー (Admin SDK) のみ
    match /custom_pieces/{word} {
      allow read: if true;
      allow write: if false;
    }

    // レート制限カウンタ: サーバー専用
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // 対局データ: 参加者だけが更新できる
    match /matches/{roomCode} {
      allow read: if signedIn();

      allow create: if signedIn()
        && roomCode.matches('^[0-9]{6}$')
        && request.resource.data.senteUid == request.auth.uid
        && request.resource.data.goteUid == null;

      allow update: if signedIn() && (
        // 既存の参加者
        request.auth.uid == resource.data.senteUid
        || request.auth.uid == resource.data.goteUid
        // 空席への入室（自分のuidを後手として登録する場合のみ）
        || (resource.data.goteUid == null
            && request.resource.data.goteUid == request.auth.uid
            && request.resource.data.senteUid == resource.data.senteUid)
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.senteUid;
    }

    // ランダムマッチ待機列
    match /matchmaking_queue/{entryId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      // マッチした相手が待機エントリを取り除くため、ログイン済みなら削除可
      allow delete: if signedIn();
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
